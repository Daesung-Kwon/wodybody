# Sprint 3 Phase C — E2E 격리 전용 환경변수.
# `vite --mode test` 시 로드되며, 어떤 운영 자격증명도 포함하지 않는다.
# 모든 값은 localhost 로 향하므로, MSW 모킹이 실패하더라도 운영 Supabase/Grok 으로
# 네트워크가 새지 않는다 (이중 격리).
VITE_SUPABASE_URL=http://localhost:5173/mock
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_AI_ADVICE_URL=http://localhost:5173/mock/ai/advice
# 분석은 E2E 에서 비활성 — track() 은 no-op.
VITE_ANALYTICS_DOMAIN=
